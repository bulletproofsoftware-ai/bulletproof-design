{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["assets"],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "file", "category", "format", "size"],
        "properties": {
          "name": { "type": "string" },
          "file": { "type": "string" },
          "category": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "usage": { "type": "string" },
          "format": { "type": "string" },
          "size": { "type": "string" },
          "incomplete": { "type": "boolean" }
        }
      }
    }
  }
}
