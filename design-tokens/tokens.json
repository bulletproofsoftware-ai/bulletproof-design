{
  "brand": {
    "primary":   { "$value": "#3b82f6", "$type": "color" },
    "secondary": { "$value": "#f1f5f9", "$type": "color" },
    "accent":    { "$value": "#eff6ff", "$type": "color" },
    "accent-foreground": { "$value": "#1e40af", "$type": "color" },
    "neutral":   { "$value": "#64748b", "$type": "color" }
  },
  "surface": {
    "background": { "$value": "#f0f4f8", "$type": "color" },
    "elevated":   { "$value": "#ffffff", "$type": "color" },
    "sunken":     { "$value": "#e0e4e8", "$type": "color" },
    "overlay":    { "$value": "rgba(15, 23, 42, 0.5)", "$type": "color" }
  },
  "text": {
    "primary":   { "$value": "#0f172a", "$type": "color" },
    "secondary": { "$value": "#475569", "$type": "color" },
    "muted":     { "$value": "#64748b", "$type": "color" },
    "inverse":   { "$value": "#ffffff", "$type": "color" },
    "link":      { "$value": "#3b82f6", "$type": "color" }
  },
  "border": {
    "default": { "$value": "#e2e8f0", "$type": "color" },
    "strong":  { "$value": "#cbd5e1", "$type": "color" },
    "subtle":  { "$value": "#f1f5f9", "$type": "color" }
  },
  "status": {
    "success": { "$value": "#10b981", "$type": "color" },
    "warning": { "$value": "#f59e0b", "$type": "color" },
    "error":   { "$value": "#ef4444", "$type": "color" },
    "info":    { "$value": "#3b82f6", "$type": "color" }
  },
  "radius": {
    "none":   { "$value": "0",        "$type": "dimension" },
    "soft":   { "$value": "0.375rem", "$type": "dimension" },
    "medium": { "$value": "0.75rem",  "$type": "dimension" },
    "full":   { "$value": "9999px",   "$type": "dimension" }
  },
  "spacing": {
    "xs":  { "$value": "0.25rem", "$type": "dimension" },
    "sm":  { "$value": "0.5rem",  "$type": "dimension" },
    "md":  { "$value": "1rem",    "$type": "dimension" },
    "lg":  { "$value": "1.5rem",  "$type": "dimension" },
    "xl":  { "$value": "2rem",    "$type": "dimension" },
    "2xl": { "$value": "3rem",    "$type": "dimension" }
  },
  "shadow": {
    "sm": { "$value": "0 2px 8px rgba(15, 23, 42, 0.06)",  "$type": "shadow" },
    "md": { "$value": "0 4px 16px rgba(15, 23, 42, 0.08)", "$type": "shadow" },
    "lg": { "$value": "0 20px 40px rgba(15, 23, 42, 0.12)", "$type": "shadow" }
  },
  "motion": {
    "fast":   { "$value": "150ms", "$type": "duration" },
    "normal": { "$value": "300ms", "$type": "duration" },
    "slow":   { "$value": "500ms", "$type": "duration" }
  }
}
