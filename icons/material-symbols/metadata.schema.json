{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/schemas/material-symbols-metadata.schema.json",
  "title": "MaterialSymbolsMetadata",
  "description": "Formal schema for icons/material-symbols/metadata.json produced by scripts/sync-icons.ts",
  "type": "object",
  "required": ["version", "source", "generated", "icons"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Semantic version of the metadata format",
      "minLength": 1
    },
    "source": {
      "const": "google/material-design-icons"
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp the metadata was generated"
    },
    "icons": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["name", "category", "tags", "aliases", "styles"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "minLength": 1,
            "maxLength": 128
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 64
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 32
          },
          "styles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": ["outlined", "rounded", "sharp"]
            }
          }
        }
      }
    }
  }
}
