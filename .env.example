# bulletproof-design — example environment configuration (local development)
# Copy to .env and adjust. Values shown are the local-dev code defaults.

NODE_ENV=development

# Next.js portal (dev server: npm run dev -> http://localhost:8095)
NEXT_PUBLIC_API_URL=http://localhost:8096

# Asset API server (npm run api). Code reads PORT (default 8096).
PORT=8096
# Where the portal reaches the API server-side.
INTERNAL_API_URL=http://127.0.0.1:8096
# Comma-separated allowed CORS origins for the API.
CORS_ORIGIN=http://localhost:8095

# Content directories (local-dev relative paths; the Docker image uses /app/*)
BRANDS_DIR=./brands
ASSETS_DIR=./assets
TEMPLATES_DIR=./templates
ICONS_DIR=./icons/material-symbols

# Feature flags (0 = enabled, 1 = disabled)
DISABLE_PORTAL=0
DISABLE_ICONS=0
DISABLE_ENRICHED_COMPONENTS=0
# Portal pages emit noindex,nofollow unless PORTAL_INDEX=1 (secure by default).
PORTAL_INDEX=

# Required in production — API key for write operations
# DESIGN_API_KEY=your-secret-api-key-here

# Optional — GitHub token for icon sync (raises rate limits)
# GITHUB_TOKEN=ghp_your-token-here

# Optional — Gemini API key for template generation
# GEMINI_API_KEY=your-gemini-api-key-here
