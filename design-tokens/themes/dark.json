{
  "brand": {
    "primary":   { "$value": "#60a5fa", "$type": "color" },
    "secondary": { "$value": "#1e293b", "$type": "color" },
    "accent":    { "$value": "#1e3a5f", "$type": "color" },
    "accent-foreground": { "$value": "#93c5fd", "$type": "color" },
    "neutral":   { "$value": "#94a3b8", "$type": "color" }
  },
  "surface": {
    "background": { "$value": "#0f172a", "$type": "color" },
    "elevated":   { "$value": "#1e293b", "$type": "color" },
    "sunken":     { "$value": "#020617", "$type": "color" },
    "overlay":    { "$value": "rgba(0, 0, 0, 0.6)", "$type": "color" }
  },
  "text": {
    "primary":   { "$value": "#f1f5f9", "$type": "color" },
    "secondary": { "$value": "#cbd5e1", "$type": "color" },
    "muted":     { "$value": "#94a3b8", "$type": "color" },
    "inverse":   { "$value": "#0f172a", "$type": "color" },
    "link":      { "$value": "#60a5fa", "$type": "color" }
  },
  "border": {
    "default": { "$value": "#334155", "$type": "color" },
    "strong":  { "$value": "#475569", "$type": "color" },
    "subtle":  { "$value": "#1e293b", "$type": "color" }
  },
  "status": {
    "success": { "$value": "#34d399", "$type": "color" },
    "warning": { "$value": "#fbbf24", "$type": "color" },
    "error":   { "$value": "#f87171", "$type": "color" },
    "info":    { "$value": "#60a5fa", "$type": "color" }
  },
  "shadow": {
    "sm": { "$value": "0 2px 8px rgba(0, 0, 0, 0.3)",  "$type": "shadow" },
    "md": { "$value": "0 4px 16px rgba(0, 0, 0, 0.4)", "$type": "shadow" },
    "lg": { "$value": "0 20px 40px rgba(0, 0, 0, 0.5)", "$type": "shadow" }
  }
}
